# SwingMachine infrastructure-only local defaults.
#
# The current code does not load this file automatically. It is an operator
# template for local shell scripts, notebooks, or future orchestration.
# Do not add broker credentials here. Strategy behaviour must not be controlled
# through environment variables. Paper trading is blocked and live trading is
# prohibited.

SWINGMACHINE_DATABASE_URL=sqlite+pysqlite:///./swingmachine_runtime.db
SWINGMACHINE_CONFIG_PATH=swing_trading_bot_config_template_v2.yaml
SWINGMACHINE_RUNTIME_INPUT=examples/runtime_cycle_input.yaml
SWINGMACHINE_NEXT_SESSION_MARKET_DATA=examples/next_session_market_data.csv
SWINGMACHINE_OUTPUT_DIR=output/demo-offline-shadow
SWINGMACHINE_RUNTIME_MODE=SHADOW
